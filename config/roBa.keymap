#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&trackball {
    automouse-layer = <4>;
    scroll-layers = <5>;

    // arrows {
    //     layers = <3>;
    //     bindings =
    //         <&kp RIGHT_ARROW>,
    //         <&kp LEFT_ARROW>,
    //         <&kp UP_ARROW>,
    //         <&kp DOWN_ARROW>;
    //     tick = <10>;
    //     wait-ms = <5>;
    //     tap-ms = <5>;
    // };
};

/ {
    combos {
        compatible = "zmk,combos";

        tab {
            bindings = <&mkp LCLK>;
            key-positions = <18 19>;
        };

        shift_tab {
            bindings = <&mkp RCLK>;
            key-positions = <19 20>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q         &kp W           &kp E             &kp R         &kp T                                          &kp Y        &kp U        &kp I              &kp O                &kp P
&kp A         &mt LEFT_ALT S  &mt LEFT_SHIFT D  &mt LCTRL F   &kp G        &kp LA(GRAVE)      &kp LG(Z)      &kp H        &mt RCTRL J  &mt RIGHT_SHIFT K  &mt RIGHT_ALT L      &kp SEMICOLON
&kp Z         &kp X           &kp C             &kp V         &kp B        &kp COLON          &kp SEMICOLON  &kp N        &kp M        &mt SLASH COMMA    &mt QUESTION PERIOD  &kp COLON
&kp LEFT_ALT  &kp LEFT_SHIFT  &kp LEFT_WIN      &lt 3 DELETE  &lt 2 SPACE  &kp TAB            &kp BACKSPACE  &lt 1 ENTER                                                       &lt 5 ESC
            >;
        };

        FUNCTION {
            bindings = <
&kp F1   &kp F2   &kp F3  &kp F4  &kp F5                       &kp TAB      &kp HOME        &kp UP_ARROW    &kp END        &kp PRINTSCREEN
&kp F6   &kp F7   &kp F8  &kp F9  &kp F10  &trans      &trans  &kp LS(TAB)  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT      &none
&kp F11  &kp F12  &none   &none   &none    &trans      &trans  &none        &kp RA(LEFT)    &none           &kp RA(RIGHT)  &none
&trans   &trans   &trans  &trans  &trans   &trans      &trans  &trans                                                      &trans
            >;
        };

        NUM {
            bindings = <
&kp N1                 &kp N2     &kp N3     &kp N4     &kp N5                            &kp N6   &kp N7  &kp N8  &kp N9  &kp N0
&kp SQT                &kp SEMI   &kp EQUAL  &kp PLUS   &kp ASTERISK  &trans      &trans  &kp N0   &kp N4  &kp N5  &kp N6  &kp TAB
&kp LS(DOUBLE_QUOTES)  &kp COLON  &kp UNDER  &kp MINUS  &kp FSLH      &trans      &trans  &kp DOT  &kp N1  &kp N2  &kp N3  &kp ENTER
&trans                 &trans     &trans     &trans     &trans        &trans      &trans  &trans                           &trans
            >;
        };

        ARROW {
            bindings = <
&kp LS(EXCL)  &kp LS(AT)    &kp LS(POUND)  &kp LS(DLLR)  &kp LS(PRCNT)                      &kp LS(CARET)  &kp LS(AMPS)   &kp BSLH   &kp GRAVE              &kp LA(F4)
&kp LS(LT)    &kp LS(LBRC)  &kp LBKT       &kp LS(LPAR)  &none          &trans      &trans  &kp LC(LS(Q))  &kp LS(LC(A))  &kp LC(T)  &kp LC(LEFT_BRACKET)   &kp LC(SEMI)
&kp LS(GT)    &kp LS(RBRC)  &kp RBKT       &kp LS(RPAR)  &none          &trans      &trans  &none          &kp LS(LC(X))  &none      &kp LC(RIGHT_BRACKET)  &kp LC(COLON)
&trans        &trans        &trans         &trans        &trans         &trans      &trans  &trans                                                          &trans
            >;

            sensor-bindings = <&inc_dec_kp LC(PAGE_UP) LC(PAGE_DOWN)>;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        layer_6 {
            bindings = <
&trans  &trans        &trans        &trans        &trans                           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans        &trans        &trans        &trans  &trans      &trans       &trans        &trans        &trans        &trans        &trans
&trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans  &trans      &bootloader  &trans        &trans        &trans        &trans        &bt BT_CLR
&trans  &trans        &trans        &trans        &trans  &trans      &trans       &trans                                                  &bt BT_CLR_ALL
            >;
        };
    };
};
